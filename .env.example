# Kanhaiya Aushadhi Bhandar — Environment Configuration Template
# Never commit real credentials or secrets to version control.

# Public application URL (used for canonical URLs and sitemap.xml)
APP_URL=

# Server port (defaults to 3000)
PORT=3000

# Administrator dashboard password (overrides first-run claimed password when set)
ADMIN_PASSWORD=

# Optional verified Google Maps URL (leave empty until verified store pin is confirmed)
VERIFIED_MAP_URL=

# Optional Analytics & Verification IDs (kept disabled until administrator approves)
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_SITE_VERIFICATION=
META_PIXEL_ID=
